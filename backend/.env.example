# =========================================================
# GITBRIDGE CAREERS - BACKEND ENVIRONMENT CONFIGURATION
# =========================================================
# Copy this file to .env and configure your credentials.
# Never commit real credentials to version control.

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=gitbridge

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256

# Session Middleware Secret
SESSION_SECRET_KEY=your_session_secret_key_here

# Frontend Application Origin
FRONTEND_URL=http://localhost:5173

# Google OAuth (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# GitHub OAuth (Optional for GitHub Integration)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/dashboard/github/callback

# Live Job Market API (Adzuna)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
